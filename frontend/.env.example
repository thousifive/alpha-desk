# Copy to frontend/.env.local for a local production-style build (gitignored).
# In dev, leave it unset: Vite proxies /api to API_URL (default http://127.0.0.1:8000).
# On Netlify, set it in Site configuration → Environment variables, not in a file.
# Backend origin, no trailing slash and no /api suffix:
VITE_API_URL=
