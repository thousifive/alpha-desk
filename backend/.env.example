# Copy to backend/.env (gitignored). Never commit real values.
# Generate with: uv run alpha-desk hash-password
APP_PASSWORD_HASH=''
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me
# Local dev only. docker-compose.yml overrides it with /data/alpha.db (./data on the host).
# DATABASE_URL=sqlite+aiosqlite:///./alpha_desk.db

# Comma-separated browser origins allowed to call the API: your Netlify site, plus
# http://localhost:5173 only if you point a local frontend at the ts.net API. Empty = same-origin
# only, which is all `make dev` needs (Vite proxies /api). Exact origins: scheme + host, no slash.
# CORS_ORIGINS=https://alpha-desk.netlify.app

# Failed logins allowed per client IP per window before 429.
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_S=900

# Backups kept by `make backup` (newest first).
# BACKUP_KEEP=14

# Shown by GET /health. Defaults to the machine's hostname (make serve fills it in).
# SERVER_NAME=

# Proxy IPs trusted for X-Forwarded-For, so login rate limiting keys on the real client IP.
# Behind `tailscale serve` + Docker the proxy appears as the Docker gateway; leaving the default
# means all tailnet clients share one limit, which is fine for a single-user app.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Needed from M4 onward. Lives ONLY here: never in frontend code, never committed.
# ANTHROPIC_API_KEY=
